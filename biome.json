{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next*",
      "!**/test-results",
      "!**/playwright-report",
      "!**/coverage",
      "!**/.review",
      "!**/.cursor",
      "!**/content",
      "!**/pnpm-lock.yaml",
      "!**/next-env.d.ts",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/app/globals.css"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
